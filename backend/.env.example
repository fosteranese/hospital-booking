DATABASE_URL=postgres://user:password@host:5432/hospital_booking
JWT_SECRET=change-me-to-a-random-secret
DEV_MODE=true
SETTINGS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Patient-facing app URL, linked from reminder/confirmation messages so
# patients can self-serve reschedule/cancel instead of being told to call.
PATIENT_APP_URL=http://localhost:5176

# Sign in with Google. Create an OAuth 2.0 Client ID (type: "Web application")
# at https://console.cloud.google.com/apis/credentials, add this app's origin
# under "Authorized JavaScript origins" (e.g. http://localhost:5176 in dev),
# and put the resulting Client ID here. It's a public identifier, not a
# secret -- the same value also goes in frontend-nuxt's
# NUXT_PUBLIC_GOOGLE_CLIENT_ID. Leave unset to keep the feature off; the
# button simply won't render and the backend route returns a clear error.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Sign in with Apple. Needs a paid Apple Developer Program membership
# ($99/yr). In https://developer.apple.com/account -> Certificates,
# Identifiers & Profiles: create an App ID with "Sign in with Apple"
# enabled, then a Services ID (this is the value that goes here and in
# frontend-nuxt's NUXT_PUBLIC_APPLE_CLIENT_ID -- Apple's equivalent of a
# public OAuth client id, not a secret). Under that Services ID's "Sign in
# with Apple" configuration, register your real domain and a Return URL --
# unlike Google, Apple has no localhost allowance, so this genuinely cannot
# be tested until you have an HTTPS domain to register. Leave unset to keep
# the feature off; the backend route returns a clear error and (once the
# frontend Apple button exists) it won't render either.
# APPLE_SERVICES_ID=com.yourcompany.mediport.web
