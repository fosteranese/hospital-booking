DATABASE_URL=postgres://user:password@host:5432/hospital_booking
JWT_SECRET=change-me-to-a-random-secret
DEV_MODE=true
SETTINGS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Patient-facing app URL, linked from reminder/confirmation messages so
# patients can self-serve reschedule/cancel instead of being told to call.
PATIENT_APP_URL=http://localhost:5176
